{
  "name": "nucleo-dados-bdgd-web",
  "version": "1.0.0",
  "private": true,
  "description": "Núcleo de Dados da BDGD — portal público de agregados BDGD 31/12/2025. Desenvolvido por Arthur Henrique Lima.",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "npx serve@14.2.4 out -l 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "validate:data": "node scripts/validate-assets.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "lucide-react": "1.53.0",
    "maplibre-gl": "6.13.0",
    "motion": "14.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
